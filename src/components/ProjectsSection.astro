---
import { projects, type ProjectStatus } from '../data/projects';

const statusStyles: Record<
  ProjectStatus,
  { bg: string; text: string; dot: string }
> = {
  Live: {
    bg: 'bg-[var(--status-live-bg)]',
    text: 'text-[var(--status-live-text)]',
    dot: 'bg-[var(--status-live-dot)]',
  },
  'In Progress': {
    bg: 'bg-[var(--status-progress-bg)]',
    text: 'text-[var(--status-progress-text)]',
    dot: 'bg-[var(--status-progress-dot)]',
  },
  Experiment: {
    bg: 'bg-[var(--status-experiment-bg)]',
    text: 'text-[var(--status-experiment-text)]',
    dot: 'bg-[var(--status-experiment-dot)]',
  },
};

const displayedProjects = projects.filter((project) => project.featured);
---

<section
  id="projects"
  aria-labelledby="projects-heading"
  class="scroll-mt-20 border-t border-[var(--border-hairline)] py-14 sm:py-20"
>
  <div class="mx-auto max-w-3xl px-6">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="eyebrow">PROJECTS</p>
        <h2
          id="projects-heading"
          class="mt-2 font-serif text-2xl font-medium tracking-[-0.02em] text-[var(--text-primary)] sm:text-3xl"
        >
          Things I have built
        </h2>
      </div>
      <p class="text-sm text-[var(--text-muted)]">
        Selected tools, apps, and experiments
      </p>
    </div>

    <div class="mt-8 space-y-5">
      {
        displayedProjects.map((project, index) => {
          const style = statusStyles[project.status];
          const hasLinks = Boolean(
            project.liveUrl || project.secondaryUrl || project.repoUrl
          );
          const slug = project.title.toLowerCase().replace(/[^a-z0-9]+/g, '-');

          return (
            <article
              id={`project-${slug}`}
              class="project-card p-6 sm:p-7"
            >
              <div class="flex items-center justify-between gap-3">
                <h3 class="font-serif text-xl font-medium tracking-[-0.015em] text-[var(--text-primary)] sm:text-[1.375rem]">
                  {project.liveUrl ? (
                    <a
                      href={project.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="transition-colors hover:text-[var(--accent)]"
                    >
                      {project.title}
                    </a>
                  ) : (
                    project.title
                  )}
                </h3>

                <span
                  class={`inline-flex shrink-0 items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium ${style.bg} ${style.text}`}
                >
                  <span
                    class={`h-1.5 w-1.5 rounded-full ${style.dot}`}
                    aria-hidden="true"
                  />
                  <span>{project.status}</span>
                </span>
              </div>

              {project.tagline && (
                <p class="mt-1 text-sm text-[var(--text-muted)]">
                  {project.tagline}
                </p>
              )}

              <p class="mt-4 text-[0.95rem] leading-[1.68] text-[var(--text-secondary)]">
                {project.description}
              </p>

              <div class="mt-5 flex flex-col gap-4 border-t border-[var(--border-hairline)] pt-4 sm:flex-row sm:items-center sm:justify-between">
                <ul class="flex flex-wrap items-center gap-2" aria-label={`${project.title} topics`}>
                  {project.tags.map((tag) => (
                    <li class="rounded-md bg-[var(--bg-subtle)] px-2.5 py-1 text-xs font-medium text-[var(--text-secondary)]">
                      {tag}
                    </li>
                  ))}
                </ul>

                <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
                  {project.liveUrl && (
                    <a
                      id={`project-live-${index}`}
                      href={project.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 font-medium text-[var(--accent)] transition-colors hover:text-[var(--accent-hover)]"
                    >
                      <span>Live App</span>
                      <span class="text-xs" aria-hidden="true">&#8599;</span>
                    </a>
                  )}

                  {project.secondaryUrl && (
                    <a
                      id={`project-secondary-${index}`}
                      href={project.secondaryUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="editorial-link inline-flex items-center gap-1 text-[var(--text-secondary)]"
                    >
                      <span>{project.secondaryLabel || 'Overview'}</span>
                      <span class="text-xs text-[var(--text-muted)]" aria-hidden="true">&#8599;</span>
                    </a>
                  )}

                  {project.repoUrl && (
                    <a
                      id={`project-repo-${index}`}
                      href={project.repoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="editorial-link inline-flex items-center gap-1 text-[var(--text-secondary)]"
                    >
                      <span>GitHub</span>
                      <span class="text-xs text-[var(--text-muted)]" aria-hidden="true">&#8599;</span>
                    </a>
                  )}

                  {!hasLinks && (
                    <span class="text-xs font-medium text-[var(--text-muted)]">
                      Currently in development
                    </span>
                  )}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
