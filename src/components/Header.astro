---
import { siteConfig } from '../data/siteConfig';

const navLinks = [
  { label: 'Projects', href: '#projects' },
  { label: 'Story', href: '#story' },
  { label: 'Background', href: '#background' },
];
---

<header
  id="site-header"
  class="sticky top-0 z-40 border-b border-[var(--border-hairline)] bg-[var(--bg-page)]/92 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-6 py-3.5">
    <a
      id="nav-brand"
      href="#top"
      aria-label={`${siteConfig.name} home`}
      class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-[var(--accent)] font-serif text-sm font-medium tracking-tight text-white transition-colors hover:bg-[var(--accent-hover)] dark:text-[#0d141c]"
    >
      {siteConfig.monogram}
    </a>

    <div class="flex items-center gap-4 sm:gap-6">
      <nav aria-label="Primary navigation" class="flex items-center gap-4 sm:gap-6">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="text-xs font-medium text-[var(--text-secondary)] transition-colors hover:text-[var(--accent)] sm:text-sm sm:font-normal"
            >
              {link.label}
            </a>
          ))
        }
        {
          siteConfig.resumeReady && (
            <a
              id="nav-resume-link"
              href={siteConfig.resumeUrl}
              download
              class="text-xs font-medium text-[var(--accent)] transition-colors hover:text-[var(--accent-hover)] sm:text-sm"
            >
              Resume
            </a>
          )
        }
      </nav>

      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle color theme"
        aria-pressed="false"
        title="Switch light or dark theme"
        class="inline-flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-md border border-[var(--border-hairline)] bg-[var(--bg-surface)] text-[var(--text-secondary)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]"
      >
        <!-- Moon icon (shown in light mode) -->
        <svg
          class="h-4 w-4 dark:hidden"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <path
            d="M15.75 11.75A6.25 6.25 0 0 1 8.25 4.25a6.25 6.25 0 1 0 7.5 7.5Z"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <!-- Sun icon (shown in dark mode) -->
        <svg
          class="hidden h-4 w-4 dark:block"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <circle cx="10" cy="10" r="3.25" />
          <path
            d="M10 2.75v1.5M10 15.75v1.5M2.75 10h1.5M15.75 10h1.5M4.88 4.88l1.06 1.06M14.06 14.06l1.06 1.06M15.12 4.88l-1.06 1.06M5.94 14.06l-1.06 1.06"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('theme-toggle');
  if (toggleBtn) {
    const syncAria = () => {
      toggleBtn.setAttribute(
        'aria-pressed',
        document.documentElement.classList.contains('dark') ? 'true' : 'false'
      );
    };
    syncAria();
    toggleBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      syncAria();
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch {
        // Ignore storage errors
      }
    });
  }
</script>
