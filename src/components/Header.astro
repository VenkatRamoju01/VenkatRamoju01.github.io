---
import { siteConfig } from '../data/siteConfig';

const navLinks = [
  { label: 'Projects', href: '#projects' },
  { label: 'Story', href: '#story' },
  { label: 'Background', href: '#background' },
];
---

<header
  id="site-header"
  class="sticky top-0 z-40 border-b border-[var(--border-hairline)] bg-[var(--bg-page)]/92 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-6 py-4">
    <a
      id="nav-brand"
      href="#top"
      class="font-serif text-lg font-medium tracking-tight text-[var(--text-primary)] transition-colors hover:text-[var(--accent)]"
    >
      {siteConfig.name}
    </a>

    <div class="flex items-center gap-5 sm:gap-6">
      <nav aria-label="Primary navigation" class="hidden items-center gap-6 sm:flex">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm text-[var(--text-secondary)] transition-colors hover:text-[var(--accent)]"
            >
              {link.label}
            </a>
          ))
        }
        {
          siteConfig.resumeReady && (
            <a
              id="nav-resume-link"
              href={siteConfig.resumeUrl}
              download
              class="text-sm font-medium text-[var(--accent)] transition-colors hover:text-[var(--accent-hover)]"
            >
              Resume
            </a>
          )
        }
      </nav>

      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle color theme"
        title="Switch light or dark theme"
        class="inline-flex h-8 w-8 cursor-pointer items-center justify-center rounded-md border border-[var(--border-hairline)] bg-[var(--bg-surface)] text-[var(--text-secondary)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]"
      >
        <!-- Moon icon (shown in light mode) -->
        <svg
          class="h-4 w-4 dark:hidden"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <path
            d="M15.75 11.75A6.25 6.25 0 0 1 8.25 4.25a6.25 6.25 0 1 0 7.5 7.5Z"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <!-- Sun icon (shown in dark mode) -->
        <svg
          class="hidden h-4 w-4 dark:block"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <circle cx="10" cy="10" r="3.25" />
          <path
            d="M10 2.75v1.5M10 15.75v1.5M2.75 10h1.5M15.75 10h1.5M4.88 4.88l1.06 1.06M14.06 14.06l1.06 1.06M15.12 4.88l-1.06 1.06M5.94 14.06l-1.06 1.06"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </div>
  </div>

  <!-- Compact mobile section strip -->
  <nav
    aria-label="Mobile section navigation"
    class="border-t border-[var(--border-hairline)] px-6 py-2.5 sm:hidden"
  >
    <div class="mx-auto flex max-w-3xl items-center gap-6 overflow-x-auto text-xs font-medium text-[var(--text-secondary)]">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="whitespace-nowrap py-0.5 transition-colors hover:text-[var(--accent)]"
          >
            {link.label}
          </a>
        ))
      }
      {
        siteConfig.resumeReady && (
          <a
            href={siteConfig.resumeUrl}
            download
            class="whitespace-nowrap py-0.5 text-[var(--accent)]"
          >
            Resume
          </a>
        )
      }
    </div>
  </nav>
</header>

<script>
  const toggleBtn = document.getElementById('theme-toggle');
  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      const root = document.documentElement;
      const isDark = root.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch {
        // Ignore storage errors
      }
    });
  }
</script>
