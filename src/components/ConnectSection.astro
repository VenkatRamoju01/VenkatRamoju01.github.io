---
import { siteConfig } from '../data/siteConfig';

const showBooking = Boolean(
  siteConfig.bookingEnabled && siteConfig.bookingUrl.trim()
);
---

<section
  id="connect"
  aria-labelledby="connect-heading"
  class="scroll-mt-20 border-t border-[var(--border-hairline)] py-14 sm:py-20"
>
  <div class="mx-auto max-w-3xl px-6">
    <p class="eyebrow">CONNECT</p>
    <h2
      id="connect-heading"
      class="mt-2 font-serif text-2xl font-medium tracking-[-0.02em] text-[var(--text-primary)] sm:text-3xl"
    >
      {siteConfig.connectHeading}
    </h2>

    <p class="mt-4 max-w-xl text-[0.98rem] leading-[1.75] text-[var(--text-secondary)]">
      {siteConfig.connectNote}
    </p>

    <div class="mt-8 grid gap-3 sm:grid-cols-[1.35fr_1fr_1fr]">
      <!-- Email card -->
      <div
        class="flex flex-col justify-between rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] p-4 transition-colors hover:border-[var(--border-strong)]"
      >
        <div class="flex items-center justify-between gap-2">
          <span class="text-xs font-medium tracking-wide text-[var(--text-muted)]">
            Email
          </span>
          <button
            id="copy-email-btn"
            type="button"
            data-copy-email={siteConfig.email}
            aria-label="Copy email address"
            title="Copy email address"
            class="shrink-0 cursor-pointer rounded px-1.5 py-0.5 text-xs font-medium text-[var(--text-muted)] transition-colors hover:bg-[var(--bg-subtle)] hover:text-[var(--accent)]"
          >
            Copy
          </button>
        </div>
        <a
          id="connect-email-link"
          href={`mailto:${siteConfig.email}`}
          class="mt-2 block text-sm font-medium text-[var(--text-primary)] transition-colors hover:text-[var(--accent)]"
        >
          {siteConfig.email}
        </a>
      </div>

      <!-- LinkedIn card -->
      <a
        id="connect-linkedin-link"
        href={siteConfig.social.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex flex-col justify-between rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] p-4 transition-colors hover:border-[var(--border-strong)]"
      >
        <span class="text-xs font-medium tracking-wide text-[var(--text-muted)]">
          LinkedIn
        </span>
        <span class="mt-2 inline-flex items-center justify-between text-sm font-medium text-[var(--text-primary)] transition-colors group-hover:text-[var(--accent)]">
          <span>in/venkat-ramoju</span>
          <span class="text-xs text-[var(--text-muted)] group-hover:text-[var(--accent)]" aria-hidden="true">
            &#8599;
          </span>
        </span>
      </a>

      <!-- GitHub card -->
      <a
        id="connect-github-link"
        href={siteConfig.social.github}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex flex-col justify-between rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] p-4 transition-colors hover:border-[var(--border-strong)]"
      >
        <span class="text-xs font-medium tracking-wide text-[var(--text-muted)]">
          GitHub
        </span>
        <span class="mt-2 inline-flex items-center justify-between text-sm font-medium text-[var(--text-primary)] transition-colors group-hover:text-[var(--accent)]">
          <span>@VenkatRamoju01</span>
          <span class="text-xs text-[var(--text-muted)] group-hover:text-[var(--accent)]" aria-hidden="true">
            &#8599;
          </span>
        </span>
      </a>
    </div>

    {
      showBooking && (
        <div
          id="connect-booking-card"
          class="mt-6 flex flex-col items-start justify-between gap-4 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] p-5 sm:flex-row sm:items-center"
        >
          <div>
            <p class="text-sm font-medium text-[var(--text-primary)]">
              1:1 Conversations
            </p>
            <p class="mt-1 text-sm text-[var(--text-secondary)]">
              {siteConfig.bookingDescription}
            </p>
          </div>
          <a
            id="connect-booking-link"
            href={siteConfig.bookingUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex shrink-0 items-center gap-1.5 rounded-lg bg-[var(--accent)] px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-[var(--accent-hover)] dark:text-[#0d141c]"
          >
            <span>{siteConfig.bookingLabel}</span>
            <span class="text-xs" aria-hidden="true">&#8599;</span>
          </a>
        </div>
      )
    }
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  if (copyBtn instanceof HTMLButtonElement) {
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.dataset.copyEmail;
      if (!email) return;
      try {
        await navigator.clipboard.writeText(email);
        const original = copyBtn.textContent;
        copyBtn.textContent = 'Copied';
        setTimeout(() => {
          copyBtn.textContent = original;
        }, 1800);
      } catch {
        // Fallback if clipboard API is unavailable
        window.location.href = `mailto:${email}`;
      }
    });
  }
</script>
