---
import { siteConfig } from '../data/siteConfig';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[var(--border-hairline)] py-8">
  <div class="mx-auto flex max-w-3xl flex-col items-start justify-between gap-3 px-6 text-xs text-[var(--text-muted)] sm:flex-row sm:items-center">
    <p>&copy; {currentYear} {siteConfig.name}</p>
    <a
      href="#top"
      class="transition-colors hover:text-[var(--accent)]"
    >
      Back to top &uarr;
    </a>
  </div>
</footer>
