---
import { siteConfig } from '../data/siteConfig';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[var(--border-hairline)] py-8">
  <div class="mx-auto flex max-w-3xl flex-col items-start justify-between gap-4 px-6 text-xs text-[var(--text-muted)] sm:flex-row sm:items-start">
    <div class="space-y-1">
      <p>&copy; {currentYear} {siteConfig.name}</p>
      {
        siteConfig.footerDisclaimer && (
          <p class="text-[11px] leading-relaxed text-[var(--text-muted)]/85">
            {siteConfig.footerDisclaimer}
          </p>
        )
      }
    </div>
    <a
      href="#top"
      class="shrink-0 transition-colors hover:text-[var(--accent)]"
    >
      Back to top &uarr;
    </a>
  </div>
</footer>
