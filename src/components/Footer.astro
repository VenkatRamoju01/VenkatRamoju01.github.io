---
import { siteConfig } from '../data/siteConfig';

const currentYear = new Date().getFullYear();
const showBooking = Boolean(
  siteConfig.bookingEnabled && siteConfig.bookingUrl.trim()
);
---

<footer
  id="contact"
  class="border-t border-[var(--border-hairline)] py-12 sm:py-14"
>
  <div class="mx-auto max-w-3xl px-6">
    <!-- Single consolidated contact strip -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-col gap-2.5 text-sm sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-5 sm:gap-y-2">
        <span class="inline-flex items-center gap-2">
          <a
            id="footer-email-link"
            href={`mailto:${siteConfig.email}`}
            class="editorial-link font-medium"
          >
            {siteConfig.email}
          </a>
          <button
            id="copy-email-btn"
            type="button"
            data-copy-email={siteConfig.email}
            aria-label="Copy email address"
            title="Copy email address"
            class="cursor-pointer rounded px-1.5 py-0.5 text-xs font-medium text-[var(--text-muted)] transition-colors hover:bg-[var(--bg-subtle)] hover:text-[var(--accent)]"
          >
            Copy
          </button>
        </span>

        <span class="hidden text-[var(--border-strong)] sm:inline" aria-hidden="true">/</span>

        <div class="flex items-center gap-x-5">
          <a
            id="footer-linkedin-link"
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="editorial-link inline-flex items-center gap-1"
          >
            <span>LinkedIn</span>
            <span class="text-xs text-[var(--text-muted)]" aria-hidden="true">&#8599;</span>
          </a>

          <span class="text-[var(--border-strong)]" aria-hidden="true">/</span>

          <a
            id="footer-github-link"
            href={siteConfig.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="editorial-link inline-flex items-center gap-1"
          >
            <span>GitHub</span>
            <span class="text-xs text-[var(--text-muted)]" aria-hidden="true">&#8599;</span>
          </a>
        </div>
      </div>

      <a
        href="#top"
        class="shrink-0 text-xs text-[var(--text-muted)] transition-colors hover:text-[var(--accent)]"
      >
        Back to top &uarr;
      </a>
    </div>

    {
      showBooking && (
        <div
          id="footer-booking-card"
          class="mt-6 flex flex-col items-start justify-between gap-4 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] p-5 sm:flex-row sm:items-center"
        >
          <div>
            <p class="text-sm font-medium text-[var(--text-primary)]">
              1:1 Conversations
            </p>
            <p class="mt-1 text-sm text-[var(--text-secondary)]">
              {siteConfig.bookingDescription}
            </p>
          </div>
          <a
            id="footer-booking-link"
            href={siteConfig.bookingUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex shrink-0 items-center gap-1.5 rounded-lg bg-[var(--accent)] px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-[var(--accent-hover)] dark:text-[#0d141c]"
          >
            <span>{siteConfig.bookingLabel}</span>
            <span class="text-xs" aria-hidden="true">&#8599;</span>
          </a>
        </div>
      )
    }

    <!-- Copyright & quiet employer disclaimer -->
    <div class="mt-8 border-t border-[var(--border-hairline)] pt-6 text-xs text-[var(--text-muted)]">
      <div class="flex flex-col gap-1.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
        <p class="shrink-0">&copy; {currentYear} {siteConfig.name}</p>
        {
          siteConfig.footerDisclaimer && (
            <p class="text-[11px] leading-relaxed text-[var(--text-muted)]/85">
              {siteConfig.footerDisclaimer}
            </p>
          )
        }
      </div>
    </div>
  </div>
</footer>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  if (copyBtn instanceof HTMLButtonElement) {
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.dataset.copyEmail;
      if (!email) return;
      try {
        await navigator.clipboard.writeText(email);
        const original = copyBtn.textContent;
        copyBtn.textContent = 'Copied';
        setTimeout(() => {
          copyBtn.textContent = original;
        }, 1800);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  }
</script>
