---
import { siteConfig } from '../data/siteConfig';
import ResumeButton from './ResumeButton.astro';

const hasPhoto = Boolean(siteConfig.photoUrl.trim());
---

<section id="top" class="pt-14 pb-14 sm:pt-20 sm:pb-20">
  <div class="mx-auto max-w-3xl px-6">
    <div
      class={hasPhoto
        ? 'flex flex-col-reverse items-start justify-between gap-8 sm:flex-row sm:items-center sm:gap-10'
        : 'max-w-2xl'}
    >
      <div class="flex-1">
        <p class="eyebrow">{siteConfig.eyebrow}</p>

        <h1
          class="mt-4 font-serif text-4xl font-medium tracking-[-0.025em] text-[var(--text-primary)] sm:text-5xl"
        >
          {siteConfig.name}
        </h1>

        <p
          class="mt-5 text-base leading-[1.72] text-[var(--text-secondary)] sm:text-[1.0625rem]"
        >
          {siteConfig.heroIntro}
        </p>

        <!-- Primary actions -->
        <div class="mt-7 flex flex-wrap items-start gap-3">
          <a
            id="hero-view-projects"
            href="#projects"
            class="inline-flex items-center gap-2 rounded-lg bg-[var(--accent)] px-4 py-2.5 text-sm font-medium text-white transition-colors duration-150 hover:bg-[var(--accent-hover)] dark:text-[#0d141c]"
          >
            <span>View Projects</span>
            <svg
              class="h-4 w-4"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              aria-hidden="true"
            >
              <path
                d="M10 4.5v11m0 0l-4-4m4 4l4-4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>

          <ResumeButton idPrefix="hero" variant="secondary" />
        </div>

        <!-- Direct inline links -->
        <div
          class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-[var(--text-secondary)]"
        >
          <a
            id="hero-email-link"
            href={`mailto:${siteConfig.email}`}
            class="editorial-link inline-flex items-center gap-1.5"
          >
            <span>Email</span>
          </a>
          <span class="text-[var(--border-strong)]" aria-hidden="true">/</span>
          <a
            id="hero-linkedin-link"
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="editorial-link inline-flex items-center gap-1"
          >
            <span>LinkedIn</span>
            <span class="text-xs text-[var(--text-muted)]" aria-hidden="true">&#8599;</span>
          </a>
          <span class="text-[var(--border-strong)]" aria-hidden="true">/</span>
          <a
            id="hero-github-link"
            href={siteConfig.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="editorial-link inline-flex items-center gap-1"
          >
            <span>GitHub</span>
            <span class="text-xs text-[var(--text-muted)]" aria-hidden="true">&#8599;</span>
          </a>
        </div>
      </div>

      {
        hasPhoto && (
          <div class="shrink-0">
            <img
              src={siteConfig.photoUrl}
              alt={siteConfig.photoAlt}
              width="160"
              height="160"
              loading="eager"
              decoding="async"
              class="h-28 w-28 rounded-2xl border border-[var(--border-hairline)] object-cover shadow-xs sm:h-40 sm:w-40"
            />
          </div>
        )
      }
    </div>
  </div>
</section>
