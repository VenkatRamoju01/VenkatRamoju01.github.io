---
import { siteConfig } from '../data/siteConfig';
import ResumeButton from './ResumeButton.astro';

const hasPhoto = Boolean(siteConfig.photoUrl.trim());
---

<section id="top" class="pt-14 pb-12 sm:pt-20 sm:pb-16">
  <div class="mx-auto max-w-3xl px-6">
    <div
      class={hasPhoto
        ? 'flex flex-col-reverse items-start justify-between gap-8 sm:flex-row sm:items-center sm:gap-10'
        : 'max-w-2xl'}
    >
      <div class="flex-1">
        <h1
          class="font-serif text-4xl font-medium tracking-[-0.025em] text-[var(--text-primary)] sm:text-5xl"
        >
          {siteConfig.name}
        </h1>

        <p
          class="mt-5 text-base leading-[1.75] text-[var(--text-primary)] sm:text-[1.0625rem]"
        >
          {siteConfig.heroGreeting}
        </p>

        <p
          class="mt-3 text-base leading-[1.75] text-[var(--text-secondary)] sm:text-[1.0625rem]"
        >
          {siteConfig.heroSubline}
        </p>

        {
          siteConfig.resumeReady && (
            <div class="mt-6">
              <ResumeButton idPrefix="hero" variant="secondary" />
            </div>
          )
        }
      </div>

      {
        hasPhoto && (
          <div class="shrink-0">
            <img
              src={siteConfig.photoUrl}
              alt={siteConfig.photoAlt}
              width="160"
              height="160"
              loading="eager"
              decoding="async"
              class="h-28 w-28 rounded-2xl border border-[var(--border-hairline)] object-cover shadow-xs sm:h-40 sm:w-40"
            />
          </div>
        )
      }
    </div>
  </div>
</section>
